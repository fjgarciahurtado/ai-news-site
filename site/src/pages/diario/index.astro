---
import Base from '../../layouts/Base.astro';
import PageList from '../../components/PageList.astro';
import { getNews, type Page } from '../../lib/news';

const news = getNews();
const byMonth = new Map<string, Page[]>();
for (const page of news.daily) {
  const month = page.date.slice(0, 7);
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(page);
}
const monthName = (month: string) => {
  const name = new Date(`${month}-15T12:00:00Z`).toLocaleDateString('es-ES', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  return name.charAt(0).toUpperCase() + name.slice(1);
};
---

<Base title="Archivo" description="Todos los resúmenes diarios y semanales, del más reciente al más antiguo.">
  <h1>Archivo</h1>
  <p class="lede">Todos los resúmenes, del más reciente al más antiguo.</p>
  {news.weekly.length > 0 && (
    <>
      <h2>Resúmenes semanales</h2>
      <PageList pages={news.weekly} show="date" />
    </>
  )}
  {[...byMonth].map(([month, pages]) => (
    <>
      <h2>{monthName(month)}</h2>
      <PageList pages={pages} show="date" />
    </>
  ))}
</Base>
